	"threatinc_reliefStays": true,
	"threatinc_swarmOrbitMinFleetFP": 50,

	# The stratum campaign: a size-S hive is S strata deep with the Fabrication
	# Core at the center. A front strong enough to hold can be ORDERED to push
	# (NPC fronts run a stance AI); each stratum taken strips its share of the
	# base defenses and of the hive's output, and taking the last one destroys
	# the Core - ERADICATION BY GROUND VICTORY, the only way a hive dies.
	# Starvation and bombardment weaken; boots on the ground finish. After each
	# stratum the front consolidates at a checkpoint, requests reinforcement,
	# and - given no orders within the window - pushes on by doctrine.
	# The hive counter-attacks on a cadence paced by its health: it can retake
	# strata from a front too weak to hold them, and overrun a beaten beachhead.
	"threatinc_frontPushBaseDays": 20,
	"threatinc_frontPushLossPer30Days": 0.30,
	"threatinc_frontPushUpkeepMult": 2.0,
	"threatinc_frontDryEffectivenessMult": 0.5,
	# THE SWARM DOES NOT FIGHT ON ARMAMENTS (2026-09-08). A faction's front is
	# the far end of a logistics chain and running dry is that chain failing.
	# The swarm has no chain - convoys and front runs resolve through hive
	# markets and a Threat front stands on a human colony, so nothing can ever
	# reach it - so charging it for a supply line it can never use was a
	# countdown wearing the costume of a supply rule. With threatFrontNeedsArms
	# false its fronts burn nothing, never run dry, and take none of the dry
	# penalties: no half strength, no tripled attrition, no final-push clock, no
	# collapse. What replaces that pressure is threatPushLossMult - casualties
	# while PUSHING, since a swarm that can break up its own hulls for troops
	# (fabricateEnabled) should pay for ground in bodies. Only while pushing: a
	# dug-in Threat front bleeds at the ordinary rate, so the counterplay is to
	# make them come to you rather than to wait them out. True restores the old
	# rule exactly, final push and all.
	"threatinc_threatFrontNeedsArms": false,
	"threatinc_threatPushLossMult": 2.0,
	"threatinc_frontEntrenchDefenseBonus": 1.5,
	"threatinc_frontCheckpointDays": 10,
	"threatinc_frontCounterAttackDays": 40,
	"threatinc_frontCounterAttackLossFraction": 0.10,
	"threatinc_npcFrontSupplyDays": 120,

	# The strategy layer (docs/strategy-layer.md). NPC factions stay vanilla
	# until the Threat strikes one of their colonies; that strike puts the
	# faction in WAR MODE. From then on its colonies accrue visible reserves
	# of marines, heavy armaments, fuel and supplies - each banked from the
	# colony's vanilla surplus of the matching commodity - and every expedition
	# draws its landing force and provisions from the colony it sails from,
	# carrying the troops as real cargo. Colonies ship stock to those staging
	# bases by convoy: real fleets, interceptable, lootable.
	"threatinc_strategyEnabled": true,
	# days after its last strike a faction stands down (only if no hive is in
	# reach of its military worlds); 0 = mobilised for good
	"threatinc_warModeStandDownDays": 0,
	# every mobilised NPC faction stands down once the swarm is gone from the
	# sector (the player's by order only); the user, 2026-10-06
	"threatinc_warStandDownOnEradication": true,
	# Factions that never mobilise, comma-separated ids. The Threat still
	# strikes their worlds and they stay hostile to it, but they raise no task
	# forces, sieges, convoys or fronts and keep no war reserve - vanilla
	# raiders, not a navy. A record already on a save is dropped on the next
	# poll (reserves kept).
	"threatinc_warExcludedFactions": "pirates",
	# every faction not excluded mobilises once the swarm reaches this phase,
	# struck or not (3 = an armada-capable hive with a core world in reach);
	# 0 = only on being struck. The player's faction mobilises by choice.
	# 0 since 2026-10-05 (the user): "They only mobilise when they are attacked."
	"threatinc_mobiliseAtPhase": 0,
	# Economy coherence (docs/economy-coherence.md): a colony banks what
	# arrives above its PEACETIME demand - the War footing's share as far as
	# it is met, plus any surplus beyond - each 30 days: those units x the
	# commodity's econ unit (1,500 fuel, 750 supplies, 200 heavy armaments,
	# 100 marines) x this multiplier. Vanilla's own local-resources
	# stockpiles pile up excess at 0.5. A colony short of its peacetime
	# needs banks nothing; a player's sale, which raises availability,
	# banks for its duration. Availability is vanilla's broadcast figure, so
	# imported surplus banks too.
	"threatinc_reserveSurplusMult": 1.0,
	"threatinc_reserveTroopSurplusMult": 1.0,
	"threatinc_hiveSurplusMult": 1.0,
	# idle supplies build a fuel plant instead of a forge while fuel is tight - losing the biggest plant would
	# run it dry (ThreatFuel.wantsSpare) - one a month; forges never retire, and with fuel at "holds, wants a
	# spare" the invest step put a forge in every free slot (2026-10-03, run hw4n: fuel-starved on 209k supplies)
	"threatinc_investFuelWhenTight": true,
	# ...once the hive has this many fuel plants: with one, losing the biggest always runs it dry, and the step put
	# a fuel plant where a home forge would have stood (2026-10-03, run hw4o, month 24)
	"threatinc_investFuelMinPlants": 2,
	# a seeding wave neither founded nor dead this many days (plus 30 a light year) after launch is
	# re-steered once, then a bootstrap wave is moved to its planet's orbit and a colony's wave lost
	# (2026-10-06, hw34b: a bootstrap wave stalled ten years and the hive never had volatiles for fuel)
	"threatinc_seedingWaveStallDays": 180,
	# a strike muster every world in reach of which waits on fuel books what
	# the hive's fuel stock is short of the cheapest passage as demand on it
	# (once a SHORT_DAYS a source), so the planner can build a plant for it
	"threatinc_strikeWaitBooksFuel": true,
	"threatinc_reserveBankFromProduction": true,
	"threatinc_reserveBankImportsMult": 1.0,
	"threatinc_reserveWartimeFuel": true,
	"threatinc_reserveWartimeSuppliesShare": 1.0,
	# War footing: every colony of a mobilised faction carries a market
	# condition (with a hidden structure behind it) that adds vanilla demand
	# for marines, heavy armaments, fuel and supplies - this many units at
	# size 5, scaled by size / 5 and rounded up (1.0: sizes 3-5 add 1 unit,
	# 6-8 add 2). A colony that was only just balanced now shows a shortage:
	# the war eating its margin. 0 adds no demand.
	"threatinc_warFootingDemandUnits": 1.0,
	# the depot counters the colony's own shortage first: while a mobilised
	# colony is short of a reserve commodity, its reserve issues the quantity
	# that lifts availability by the deficit - a trade modifier, the way a
	# sale would be - for reserveShortageCoverDays, then again when it lapses;
	# never more than this fraction of the stock at hand per issue, and only
	# whole units. When the stock cannot buy one unit the shortage stands and
	# the war board says so. 0 days turns covering off.
	"threatinc_reserveShortageCoverFraction": 0.5,
	"threatinc_reserveShortageCoverDays": 30,
	# a colony banks everything it makes (2026-09-29: no ceiling); the floor
	# and donor keep are measured in reserveCapMonths of its production, and it
	# starts with reserveInitialMonths of it the moment its faction mobilises
	# (the peacetime depots its first sortie draws from - full, so a navy
	# opens the war at full strength)
	"threatinc_reserveCapMonths": 6,
	"threatinc_reserveInitialMonths": 6,
	# NPC expeditions and sorties never draw a colony below this fraction of its
	# cap (the home garrison's stock); your own colonies use the player floor
	# instead - 0 means your orders may commit the whole stock (a colony's
	# stockpiled marines also count toward its ground defence, so an emptied
	# one is easier to land on); every colony also raises a militia trickle of
	# marines per size per 30 days regardless of industry
	"threatinc_reserveFloorFraction": 0.25,
	"threatinc_playerReserveFloorFraction": 0,
	"threatinc_reserveBaselinePerSize": 5,
	# a player colony's reserve IS its resource stockpile (vanilla fills it; the
	# mod adds the militia). A base needs a military structure AND a functional
	# Waystation (a hive world its Swarm Nexus) to stage, sail or send; a convoy
	# lands anywhere (2026-10-10: a colony without a Waystation could receive nothing);
	# an NPC faction's mobilisation builds one at each military world with a
	# spaceport, the player builds their own
	"threatinc_baseRequiresWaystation": true,
	"threatinc_mobilisationBuildsWaystation": true,
	# exponent on every ground-war strength ratio (push pace, push attrition,
	# counter-attack losses and overruns): 1 = linear and legible (default),
	# 2 = Lanchester's square law, where concentration pays four times over
	"threatinc_groundStrengthExponent": 1.0,
	# an expedition waits unless its base holds this fraction of the marines
