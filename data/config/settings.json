{
	# Threat Incursion - fallback values when LunaLib is not enabled

	# lets rules.csv resolve this mod's rule commands (ThreatincBombardCMD)
	"ruleCommandPackages":["threatinc"],

	# Master switch and clock
	"threatinc_enabled": true,
	"threatinc_tickDays": 30,

	# When the incursion begins: by default the abyss story flags wake the
	# swarm; startAtGameStart skips all triggers and begins immediately in a
	# new game (or on loading an existing one)
	"threatinc_startAtGameStart": false,

	# Alternate start trigger: a player colony reaching this size wakes the
	# swarm even if the abyss story was never touched (whichever comes first)
	"threatinc_colonySizeTrigger": true,
	"threatinc_triggerColonySize": 6,

	# Infestation lifecycle: the incursion begins from ONE resource-complete OG
	# home system (ore + volatiles mining, refining, heavy industry), whose
	# whole production chain is founded at once from the Abyss. initialSeeds
	# above 1 adds that many extra single-colony fringe footholds beyond it.
	"threatinc_initialSeeds": 1,
	"threatinc_seedToColonyDays": 120,
	"threatinc_maxInfestedSystems": 12,
	"threatinc_spreadMinSize": 3,

	# Colonies: growth pacing, size cap, garrison and colonization fleets.
	# The hive runs a real, self-contained economy - shortages of metals or
	# machinery stall growth, and ship-hull shortages shrink garrisons/strikes
	"threatinc_colonyGrowthBaseDays": 60,
	"threatinc_colonyMaxSize": 8,
	# Spare copies of each production link (refinery, forge, fuel plant) the
	# hive builds as it spreads - one per infested system it holds, up to this
	# many. Under vanilla's economy one producer feeds every hive world that can
	# reach it, so spares add nothing until the original is lost; they exist so
	# that cutting the hive's supply of anything means cutting several worlds.
	# 1 = a single point of failure for each.
	"threatinc_chainRedundancy": 3,
	"threatinc_colonizationEscort": 2,
	"threatinc_garrisonRespawnDays": 40,
	# Colonies cover each other. Every poll the swarm sends ONE Defense Swarm (up
	# to reinforceMaxPerPoll) from the best-covered colony that can reach a
	# worn-down sibling - same system first, then any system within the donor's
	# fuel range - until garrisons balance out. The swarms physically fly there
	# and can be intercepted. A donor must be able to regrow what it sends (Core
	# and Nexus both up) and always keeps one swarm home.
	"threatinc_reinforceEnabled": true,
	"threatinc_reinforceMaxPerPoll": 2,
	# A garrison slot is a promise of a certain weight of defense. A swarm shot
	# below this fraction of the fleet points it was fabricated with, or one of a
	# lower tier than the slot wants (a small colony's swarm sent to a big one),
	# is a WEAK HOLDER: it keeps fighting but no longer blocks the nexus, which
	# grows a proper replacement at its normal cadence and recycles the weak one.
	"threatinc_garrisonUnderStrengthFraction": 0.5,
	"threatinc_economyGatesGrowth": true,
	# The first hive system carries Domain-era items the way a swarm out of the
	# Abyss would: a Pristine Nanoforge on its largest forge, and a Mantle Bore,
	# Plasma Dynamo, Catalytic Core or Synchrotron wherever its own deposits
	# leave a link short. Vanilla's chain only balances at size 8 with these;
	# every later colony draws on the home hive, and the items are the loot for
	# taking it. Every other forge in the hive has the chance below of carrying
	# a Corrupted Nanoforge - a fixed roll per world.
	"threatinc_homeRelics": true,
	"threatinc_forgeNanoforgeChance": 0.2,
	# The hive is a closed economy that never trades with the Core worlds, so
	# vanilla's distance-from-Core accessibility penalty models a supply line it
	# doesn't have. This cancels that penalty for hive colonies (1 = fully, 0 =
	# leave it). Distance from the rest of the hive does not move accessibility
	# either way: vanilla's same-faction proximity term is only ever a bonus.
	"threatinc_coreDistanceOffset": 1.0,
	# A disrupted port is a skeleton port. Vanilla keeps a disrupted Spaceport
	# counted as present, so it only loses the port's bonus and, since
	# same-faction shipping is 5+ units down to 0% accessibility, a disrupted
	# hive port changed nothing. While a hive world's port is disrupted its
	# shipping (imports and exports alike) is capped at this many units: a
	# size-8 forge gets 3 of the 8 metals it wants, growth stalls, its output
	# reaches the hive only as a trickle. Not zero on purpose - with the Core
	# also down a colony's machinery is imported, and zero shipping made a port
	# cut deadlier than a Core cut. 0 = nothing docks, -1 = vanilla behaviour.
	"threatinc_disruptedPortShipping": 3,
	"threatinc_convertDecivWorlds": true,
	# Defense-board contracts are ordinary missions: offered through the comm
	# network, accepted or ignored like a survey posting. Offers stand for
	# missionPostingDays and may be withdrawn until accepted; accepting one
	# starts a missionDurationDays completion clock, and failing or abandoning
	# it costs reputation with the sponsoring faction. Several offers stand at
	# once, split across two boards - a strategic tier naming the decisive
	# target and an immediate tier naming the low-hanging fruit, always at
	# least one of each - and the weakest offer on a board is withdrawn when a
	# better target of that same tier comes online. Accepted contracts are
	# never withdrawn and do not count against the offer cap.
	"threatinc_missionsEnabled": true,
	"threatinc_missionBaseReward": 150000,
	"threatinc_missionPostingDays": 90,
	"threatinc_missionDurationDays": 120,
	"threatinc_maxPostedMissions": 3,
	"threatinc_missionSupersedeMargin": 1.35,
	"threatinc_missionMinStandDays": 60,
	"threatinc_missionProximityBonus": 0.35,
	"threatinc_missionStrategicRewardMult": 1.5,

	# Phases are capability, not calendar: 2 = some colony can stage a strike,
	# 3 = some colony can field a full-budget armada (size 6+, nominal hulls)
	"threatinc_phase3Enabled": true,

	# Strikes: launched from colonies of at least strikeMinSize; strength is
	# size squared times the multiplier, degraded by hull shortages
	# 0 = unlimited
	"threatinc_maxConcurrentStrikes": 0,
	"threatinc_strikeLYPerFuel": 4.0,
	# Reach = strikeLYPerFuel x min(fuel available, fuel the fleets can carry).
	# The fleets carry this many units at a fleet-size figure of 100 percent.
	# Faction and player worlds use vanilla's own figure untouched (colony
	# size, doctrine, hull shortage, stability, alpha core, skills - the
	# Fleets percentage on the colony screen); hive worlds use vitality x
	# size / 4 (a healthy size-4 hive lifts a full load, size 8 twice that, a
	# size-2 foothold half, a besieged world less as its vitality falls).
	"threatinc_reachFuelCarry": 4,
	"threatinc_strikeMinSize": 4,
	"threatinc_strikeStrengthMult": 1.0,
	"threatinc_playerGraceDays": 120,
	# breaking the staging colony's forge (raid/bombardment/destruction) while
	# an expedition is still PREPARING there makes it stillborn; departed
	# expeditions are autonomous
	"threatinc_strikeRecallEnabled": true,
	# if false, strikes never target story-critical worlds (the engine refuses
	# to destroy them); if true, the swarm may erase them - can break unfinished
	# vanilla storylines
	"threatinc_destroyStoryCritical": true,
	# scale on hive ground-defense strength; bombardment fuel cost scales with it
	"threatinc_groundDefenseMult": 1.0,

	# Hive sieges: every hive lives deep underground behind ground defenses
	# anchored to COLONY SIZE (hiveDefensePerSize x size, immune to unrest,
	# then multiplied by the defense industries - a size-8 hive's true figure
	# runs five digits). Saturation bombardment costs the full defense figure
	# and only disrupts industries for days; it can NEVER reduce population.
	# Tactical bombardment costs a fraction and suppresses the war-strata
	# longer; marine raids disrupt longest. The only way a hive dies is
	# decline: population falling to size 1 under disruption or shortages.
	"threatinc_hiveDefensePerSize": 400,
	# defense-structure scaling: defense mult = 1 + bonus per structure, with
	# disruptedDefenseFraction of the bonus surviving a fresh disruption
	"threatinc_groundDefensesBonus": 1.0,
	"threatinc_heavyBatteriesBonus": 2.0,
	"threatinc_nexusDefenseBonus": 0.5,
	"threatinc_disruptedDefenseFraction": 0.5,
	# ...and wearing down from there: the surviving bonus falls linearly with
	# the disruption days on the structure's clock, to nothing at this many.
	# The same wear applies to a disrupted Core's fabrication factor
	# (coreDownFactor at fresh disruption, zero at the limit). Disruption
	# stacks with every pass and raid, so an organ carrying
	# 300 days has been hit again and again and is scrap. One tactical pass
	# (60 d) leaves 40 percent of a battery's bonus, two raids on top about 25
	# percent. The size-anchored base never wears. 0 = no wear.
	"threatinc_defenseWearDays": 300,
	"threatinc_hiveBombardCostMult": 1.0,
	"threatinc_hiveTacCostFraction": 0.25,
	"threatinc_hiveSatDisruptDays": 20,
	"threatinc_hiveTacDisruptDays": 60,
	"threatinc_hiveMarineLossMult": 1.5,
	# NPC siege doctrine: an AI purge expedition keeps delivering tactical
	# bombardments (stacking their disruption, so each pass wears the war-strata
	# further) while any defense structure's surviving effect is still above
	# this fraction; once bombed below it, the expedition lands troops instead.
	# 0.5 = one pass then raid (old behavior); lower = more softening passes
	# before the ground assault; 0 = grind the war-strata to nothing first.
	"threatinc_siegeDefenseSoftenFloor": 0.25,

	# Colony decline: a colony whose health (input satisfaction x structure
	# functionality) falls below the threshold loses population at a FIXED
	# rate - not scaled by depth, duration, or colony size - until it
	# collapses at size 1. Fixed so the projected timelines are exact:
	# disrupting a bigger colony costs more, but the effect is identical.
	"threatinc_declineHealthThreshold": 0.35,
	"threatinc_declineBasePerTick": 0.25,
	"threatinc_declineRecoveryPerTick": 0.05,
	# fabrication factor while the Fabrication Core is disrupted (health = fab x
	# supply; coreDownFactor below declineHealthThreshold = a dead Core forces
	# decline). The Swarm Nexus is NOT a vitality organ - it only fabricates
	# fleets, so disrupting it halts swarm spawning without touching health.
	"threatinc_coreDownFactor": 0.25,
	# growth pace ramps from 0 at stall health to full at full health
	"threatinc_growthStallHealth": 0.5,
	"threatinc_growthFullHealth": 0.85,

	# Faction reactive defense: task forces against garrisons, and - when a
	# colony's garrison has been wiped out - siege expeditions
	"threatinc_responseEnabled": true,
	# 0 = unlimited
	"threatinc_responseMaxConcurrent": 0,
	# reach is fuel and fleets: a military world projects task forces and
	# sieges by the same rule as hive strikes (see threatinc_reachFuel* above)
	"threatinc_responseMinDifficulty": 4,
	"threatinc_responseMaxDifficulty": 10,
	"threatinc_responseStrengthDivisor": 30,
	# Siege expeditions (NPC and commissioned alike) are sized to the target's
	# defenses: vanilla disrupts an industry only when the landing force is at
	# least a third of the defender strength, so fleets are added until the
	# estimated ground strength clears that with headroom. NPC ground strength
	# is a quarter of crew capacity, which tracks fleet size - one difficulty
	# point of fleet lands about this much (measured: 22 points landed 947).
	"threatinc_siegeRaidStrPerPoint": 43,
	# Cap on how many fleets a siege grows to. A size-8 hive behind Heavy
	# Batteries needs ~3,600 ground strength once its war-strata are suppressed
	# by the tactical pass; at ~430 per full-size fleet that is 9 fleets.
	"threatinc_siegeMaxFleets": 10,
	"threatinc_responsePurgeEnabled": true,
	"threatinc_purgeCooldownDays": 240,
	# hive colonies up to this size are purged preemptively, garrison or not;
	# larger DEFENDED colonies can draw a full assault too, but on a cooldown
	# stretched by purgeDefendedCooldownMult and with extra escort fleets
	"threatinc_purgePreemptMaxSize": 3,
	"threatinc_purgeDefendedCooldownMult": 2.0,
	# wounded colonies (open decline meter or disrupted organs) draw follow-up
	# expeditions on this short cooldown - navies press an advantage
	"threatinc_purgeFollowUpDays": 75,

	# Player-commissioned expeditions: from a player colony with a military
	# structure in response range, hire the same siege expedition NPC navies
	# run - priced by flotilla size and distance
	"threatinc_commissionEnabled": true,
	"threatinc_commissionCostPerPoint": 15000,
	"threatinc_commissionCostPerLY": 8000,

	# Remnant immune system (pairs with Remnant Retribution, but works with
	# vanilla Remnant systems regardless)
	"threatinc_remnantResists": true,
	"threatinc_machineWarWinChance": 0.35,

	# Faction relations. The Threat is a machine menace at war with all life:
	# permaHostile pins it to vengeful with every faction (so it reads as
	# openly hostile on the relations screen, not merely "not currently
	# hostile"). bombardNoAtrocity waives the vanilla saturation-bombardment
	# reputation penalty when the colony you bomb is a Threat colony - civilized
	# factions do not brand you a war criminal for exterminating the swarm.
	"threatinc_permaHostile": true,
	"threatinc_bombardNoAtrocity": true,

	# Debug
	"threatinc_debugMode": false,
	"threatinc_debugLogging": false,
	"threatinc_debugForceStart": false,
	"threatinc_debugFastClock": false,
	"threatinc_debugGrantSensorMods": false,
	"threatinc_debugReset": false,
}
