{
	# Abyssal War - fallback values when LunaLib is not enabled

	# lets rules.csv resolve this mod's rule commands (ThreatincBombardCMD)
	"ruleCommandPackages":["threatinc"],

	# Master switch and clock
	"threatinc_enabled": true,
	"threatinc_tickDays": 30,

	# When the war begins: by default (startAtGameStart) the swarm was
	# always coming and the war starts immediately in a new game (or on
	# loading an existing one). Turn it off to wait for the abyss story flags
	# or the colony-size trigger below instead
	"threatinc_startAtGameStart": true,

	# Alternate start trigger: a player colony reaching this size wakes the
	# swarm even if the abyss story was never touched (whichever comes first)
	"threatinc_colonySizeTrigger": true,
	"threatinc_triggerColonySize": 6,

	# Infestation lifecycle: the war begins from ONE resource-complete OG
	# home system (ore + volatiles mining, refining, heavy industry), whose
	# whole production chain is founded at once from the Abyss. initialSeeds
	# above 1 adds that many extra single-colony fringe footholds beyond it.
	"threatinc_initialSeeds": 1,
	# homeWorlds: the worlds the swarm lands on at the start, in a home system
	# with at least that many planets (the most the sector has, if none does).
	# 3 is the easier war (its second forge, and so its spread, come about a
	# year later); above 4 the simulator finds no difference (war-sim-rounds 18).
	"threatinc_homeWorlds": 4,
	"threatinc_seedToColonyDays": 120,
	"threatinc_spreadMinSize": 3,

	# Colonies: growth pacing, garrison and colonization fleets. The hive runs
	# a real, self-contained economy - shortages of metals or machinery stall
	# growth. Colonies grow to colonyMaxSize (8, restored 2026-09-30); the hive builds
	# a spare of each production link per system it holds, as its free
	# industry slots allow (2026-09-29: chainRedundancy 3 was a cap).
	# Every fleet it fields is paid from an FP bank per colony,
	# filled by its forges' ship output at fabFPPerShipUnit FP per ship unit
	# per 30 days - no bank, no build (a closed economy)
	"threatinc_colonyMaxSize": 8,
	"threatinc_colonyGrowthBaseDays": 60,
	"threatinc_fabFPPerShipUnit": 100,
	# a Seeding Swarm's hulls become its colony, not its garrison: the launching
	# colony's bank also pays this much per structure the colony is founded
	# with (Population, Spaceport, Fabrication Core, Swarm Nexus, a first
	# industry), and the new hive builds its garrison from its own bank
	"threatinc_foundingFPPerStructure": 150,
	# upkeep: every 30 days a colony's bank pays this fraction of the fleet
	# points of the fleets it owns (its garrison, raiders, reinforcements
	# inbound, strikes/waves/scouts it paid for). A bank that cannot carry its
	# fleets stops building and recycles its weakest swarms until it can -
	# a garrison settles where income = upkeep, i.e. at income / this rate
	"threatinc_garrisonUpkeepPerMonth": 0.04,
	"threatinc_colonizationEscort": 2,
	# military options menu: how far (su) from a hive's world a defending swarm
	# fleet can be engaged from its orbit (the colony's garrison, reinforcements
	# bound for it and its Defend Swarms count within defendInboundRange,
	# closing raids and bombardment until engaged; any other swarm fleet counts
	# while inside this radius; garrisons orbit 400-700 su out)
	"threatinc_defendRadius": 1000,
	# how far out (su) a swarm fleet bound for the world still counts as a
	# defender inbound; farther out it is not in the fight and the menu ignores
	# it (0 = any distance, the rule before 2026-10-13)
	"threatinc_defendInboundRange": 3000,
	# Colonies cover each other. Every poll the swarm sends Defense Swarms from
	# the best-covered colonies that can reach worn-down siblings - same system
	# first, then any system within the donor's fuel range - until garrisons
	# balance out (no per-poll limit since 2026-09-29). The swarms physically fly there
	# and can be intercepted. A donor must be able to regrow what it sends (Core
	# and Nexus both up) and always keeps one swarm home.
	"threatinc_reinforceEnabled": true,
	# Posture: every postureDays each hive system weighs the war around it
	# (attacks seen bound for it, recent losses, hostiles present, forward
	# bases in reach) and wants the garrison that pressure needs - by the
	# siege's orbit margin, times postureMargin - or its size tables' floor,
	# whichever is more. Nothing is built past the want; garrison above it by
	# postureBand and one swarm is let go to pressed siblings, waves and
	# strikes, and recycled once it has stood idle past the upkeep's
	# break-even. A quiet hive thins to its reserve to spread; a pressed one
	# launches only what it holds above the need. Off: the nexus builds past
	# the floor whenever its bank pays, as before.
	"threatinc_postureEnabled": true,
	"threatinc_postureMargin": 1.25,
	"threatinc_postureBand": 0.25,
	"threatinc_postureDays": 5,
	# The swarm's own restraints, removed 2026-10-04 (docs/game-runs.md 4);
	# each knob puts one back. postureStagedShare: the share of what a base
	# staging for a hive system COULD pay that counts as pressure on it (was
	# 1: sieges are sized to the swarm reported, not to the depot, and the
	# capacity read wrote systems off against forces nobody sent).
	# postureTriage: a system the whole hive could not hold above its bases is
	# written off and not fed. postureNeedAtAttack: a system's need stands at
	# the worlds a force is over or an army is on, not split by the size
	# tables, and a colony the war asks nothing of gives down to its reserve -
	# its launch stock included - for one under attack. posturePressedForgesHome:
	# a forge of a threatened or besieged system sends no wave and counts
	# toward no claim, whatever it holds above the need.
	"threatinc_postureStagedShare": 0,
	"threatinc_postureTriage": false,
	"threatinc_postureNeedAtAttack": true,
	"threatinc_posturePressedForgesHome": false,
	# STRIKES COME HOME (2026-10-04, the user): a hive system under attack and
	# short of its need calls in the strikes within postureRecallLY of it that
	# are still preparing or travelling out and nearer it than their target,
	# the nearest first; their fleets join its garrisons. A strike mid-siege,
	# close to its target or on its way home flies on. 0 = off
	"threatinc_postureRecallLY": 10,
	# DEFENCE IN DEPTH (the user, 2026-10-07): a quiet hive system's base want is scaled
	# by its exposure - 1 within ExposureNearLY of a human world the swarm has seen, or
	# while hostiles were seen in it within ExposureSeenDays; down to one swarm a colony
	# at ExposureFarLY and beyond, or with no human world known at all. The garrison of
	# the rear and its forges' output go to the hives the humans have found.
	# false: every quiet system wants its base.
	"threatinc_postureExposure": true,
	"threatinc_postureExposureNearLY": 10,
	"threatinc_postureExposureFarLY": 30,
	"threatinc_postureExposureSeenDays": 180,
	"threatinc_postureLine": false,
	"threatinc_postureLineDays": 365,
	# ONLY WHAT IS SHORT (2026-10-05, the user): a recalled strike sends home the
	# fleets that cover the system's shortfall and sails on with the rest; false =
	# it comes home whole (hw15: 90-94% of strikes recalled, 3,353 FP for 218 short)
	"threatinc_postureRecallPartial": true,
	# Staged strikes (the user, 2026-10-05): a strike is built for its target
	# from the whole hive's bank at a staging world, sized to outweigh the
	# defence last seen there by the margin; the closest known target first,
	# forward bases included; the garrisons stay home and nothing is recalled.
	# false: a system's spare swarms muster, and the recall above.
	"threatinc_strikeStaged": true,
	"threatinc_strikeStagedMargin": 1.5,
	# ...and takes the spare Defense Swarms of the hive's systems first (those
	# within GatherLY of the staging system; 0 = all), the banks building only
	# what is missing. With the offensive a prong takes the spare up to its need
	# and the campaign's prongs share it (the user, 2026-10-07: "spend it").
	"threatinc_strikeStagedGarrisons": true,
	"threatinc_strikeStagedGatherLY": 0,
	# The gather order of a staged strike's garrison swarms (the user, 2026-10-07): every colony's
	# fleets above its posture want before any colony's fleets below it, and within that by score -
	# this share of the colony's distance from the nearest known human world, the rest its fleet count.
	"threatinc_spareGatherDistanceShare": 0.55,
	# The strike fund: this share of every hive colony's fabrication is set aside
	# hive-wide and alone pays staged strikes; 0 = no fund, the pooled banks pay.
	# The war's OPENING strike - nobody mobilised yet - sails with at least MinFP, so
	# the hive is strong before the first attack wakes the humans; every later strike
	# is sized to its target (the user, 2026-10-06; the hw22-hw28 trials had wrongly
	# applied the floor to every strike).
	"threatinc_strikeFundShare": 0.3,
	"threatinc_strikeStagedMinFP": 8000,
	# ...and the war's first strike waits until the fund holds OpenFP (trial hw27).
	# (the user, 2026-10-10 16:30, after hw138-hw142 on the OceanPena seed: the war is
	# decided by how many factions find and press a 15-25k navy ~200-400 days after
	# the opening salvo at day ~1,300; opened later the swarm meets the answer with
	# the navy the unpressed games reach, 35-70k - trial hw143)
	"threatinc_strikeStagedOpenFP": 40000,
	# THE OFFENSIVE (the user, 2026-10-07): the hive saves its strike fund and strikes
	# every known target system at once - one prong a system, sized to the strongest
	# defence seen there - the campaign being the most valuable set the fund pays by
	# its deadline (HorizonMonths from the last launch); at the deadline the fund pays
	# what it can. Losing, by degree (the losing pressure, 0-1, below), its reach
	# shrinks from every known target toward NearLY of a hive, spoiling blows weigh
	# more, and the horizon shortens toward LosingMonths, each reached at full pressure.
	# false: the closest payable target, one strike a month.
	"threatinc_swarmOffensive": true,
	"threatinc_offensiveHorizonMonths": 12,
	"threatinc_offensiveLosingMonths": 3,
	# Losing holds the navy: from this losing pressure the offensive prices only
	# a month's fund of strikes and the rest of the fund pays the hives under
	# siege. 0 = never
	"threatinc_offensiveHoldLosing": 0.3,
	"threatinc_offensiveNearLY": 10,
	# APPROACHES FIRST (the user, 2026-10-11, after hw154a): forward bases within this of
	# their nearest staging hive are priced first, whatever the focus. 0 = none
	"threatinc_offensiveApproachLY": 10,
	# a strike at a forward base under size 4 is sized for the base one size up - the
	# station it grows into (a battlestation from 3, a star fortress from 4)
	"threatinc_strikeBaseGrowth": true,
	# FOUNDING CONVOYS (the user, 2026-10-11): a forward base's kit sails from the paying base
	# to the site in a real convoy and the base is founded when it lands with the whole kit;
	# lost at sea, the kit is lost. false: paid and stood up on the spot, as before
	"threatinc_foundingConvoy": true,
	# DEFEAT IN DETAIL (the user, 2026-10-07): the campaign masses on one faction - every
	# known system of the focus - until its worlds answer the strikes with under
	# BrokenAnswer of what they were sized for, or nothing known of it is left to strike;
	# then the faction the means cover most completely. Spoiling blows while losing stay,
	# whoever's. false: every known target at once.
	"threatinc_offensiveFocus": true,
	"threatinc_offensiveBrokenAnswer": 0.5,
	# THE LOSING PRESSURE (the user, 2026-10-07: "a series of worlds falling not just
	# a one off"): a trend over WindowDays, the larger of two - hives fallen below the
	# window's peak (none for one; full at HiveShare of the peak), and the exchange lost
	# beyond what was sunk against what the forges made (full at ExchangeShare of it).
	# 0 before any war.
	"threatinc_losingWindowDays": 365,
	"threatinc_losingHiveShare": 0.5,
	"threatinc_losingExchangeShare": 1.0,
	# NO LEAD FROM A STRIKE (2026-10-05, the user): a strike mobilises the factions
	# it sweeps and tells nothing of its origin; hives are found only by parties
	# entering their system. true = the struck faction's scouts sail to the origin
	"threatinc_strikeLeads": false,
	# INFORMATION TRAVELS BY SHIP (2026-10-05, the user): what a scouting party or
	# a Scouting Swarm sees is known to its side only once it is back in a
	# friendly system (a relay in reach), and is lost with it. false = known the
	# moment it is seen
	"threatinc_carriedIntel": true,
	# PATROLS (2026-10-05, the user): once at war each side keeps patrols out on
	# the systems around what it holds, nearest first, in place of the humans'
	# 60-day sweeps within scoutRangeLY and of both 4 ly sighting rules
	# (strikeDetectLY, swarmPicketLY). A patrol sees what is in its system and
	# forces within patrolSightLY in hyperspace, and brings it home. A side's
	# budget (patrolFPPerBase a military world; swarmPatrolFPPerSystem a hive
	# system) flies as patrols of scoutFleetPoints / swarmPatrolFP, doubled in
	# size for every patrol lost until patrolCalmDays pass without a loss.
	# Meeting a force that flies as a route is settled by strength and burn
	"threatinc_patrolsEnabled": true,
	"threatinc_patrolSightLY": 1,
	"threatinc_patrolStops": 6,
	"threatinc_patrolFPPerBase": 40,
	"threatinc_patrolCalmDays": 120,
	"threatinc_swarmPatrolFP": 30,
	"threatinc_swarmPatrolFPPerSystem": 120,
	"threatinc_swarmPatrolMemoryDays": 45,
	"threatinc_patrolBurnBombers": 6,
	"threatinc_patrolBurnSiege": 7,
	"threatinc_patrolBurnRaid": 8,
	"threatinc_patrolBurnStrike": 9,
	# MASS THE DEFENCE (2026-10-04, the user): a system under attack sends the
	# spare swarms of its own colonies - what a launch would muster - to its
	# worlds short of their need; still short once the strikes in reach have
	# turned, it draws the spare of the hive systems within postureRecallLY.
	# No strike sails from a system still short, or past one in that range;
	# an attacked system launches only what it holds above its need.
	# false = the launch-then-recall of hw8. OFF since hw9 (2026-10-05): as
	# built it exterminated the swarm in 3 of 3 - the need it masses to is
	# 2.4-4.3 times the siege over the world, every system in range is
	# stripped and nothing is left to seed or strike (docs/game-runs.md 7)
	"threatinc_postureMass": false,
	# THE SYSTEM DEFENDS AS ONE (2026-10-05, the user): a force over a hive
	# world draws the spare swarms of its system's other worlds - every fleet
	# above each one's reserve count, a world itself under attack sending
	# none - until what stands for the world outweighs the force by
	# systemDefenceMargin (0 = every spare swarm). A siege the swarm saw
	# coming fights those swarms from its first day, wherever in the system
	# they are; one that came unseen fights them as they arrive.
	# false = each world meets a siege with its own garrison, as before
	"threatinc_systemDefence": true,
	"threatinc_systemDefenceMargin": 1.25,
	# Only when it is enough (2026-10-05, the user: as the humans turn back
	# from a world too well guarded): the swarms at the world, those bound
	# for it and the system's spare must together outweigh the force, or none
	# is sent. false = whatever is spare is sent
	"threatinc_systemDefenceOnlyIfEnough": true,
	# REGIONAL RELIEF (2026-10-09, the user): a world its own system cannot
	# defend draws the spare swarms of the hives in other systems whose passage
	# the fuel pays, nearest first - each colony within its own need, a front
	# colony never below its want, a system fighting for its own worlds none -
	# sent only if all of it together outweighs the force over the world.
	# false = a system defends with its own swarms alone
	"threatinc_regionalRelief": true,
	# CONSOLIDATION (2026-10-10, the user, after hw138b: 30 hives ground to 6
	# by six factions' daily sieges at 5:1 over 127 FP garrisons, every rally
	# refused as not enough): losing at this pressure or above
	# (ThreatStance.losingPressure, 0-1), the swarm masses its garrisons on as
	# many keystone hives as can each stand the force that comes (below), and
	# the other hives keep only their patrols. 0 = never
	# OFF (the user, 2026-10-10 16:30): fired in hw140a/c, hw141b and changed no outcome;
	# concedes hives on a trend that lags the campaign by 400-1,500 days - 0 = never
	"threatinc_consolidateLosing": 0,
	# Days over which the forces seen over hive worlds are remembered
	"threatinc_consolidateWindowDays": 120,
	# The stand: this percentile of those forces (1 = the largest ever seen)
	# at the defence margin
	"threatinc_consolidateStandPercentile": 0.75,
	# Days a reinforcement swarm may be in flight before the hive logs where it
	# stands and orders it on again (hw101a: swarms sat a year in their source
	# system while their targets fell). 0 = never
	"threatinc_reinforcementOverdueDays": 90,
	# Stance: each posture pass the hive decides what its surplus is for.
	# PRESS - it holds stancePressRatio times a rival's force in reach, knows a
	# world of that rival whose defence is at most stanceWeakOdds of what it
	# could muster, and under half of stanceConsolidateShare of its systems are
	# pressed: the staging colony builds that strike and aims it; expansion
	# gets stanceSecondaryShare of its appetite. CONSOLIDATE - that share of
	# its systems pressed, or hives lost under attack, with no breathing room:
	# quiet colonies feed pressed systems and its strikes go for bases staging
	# against it first. EXPAND otherwise, seeding away from the strongest
	# rival. A stance holds stanceDwellDays (consolidating never waits). Off:
	# posture alone, as before.
	"threatinc_stanceEnabled": true,
	"threatinc_stancePressRatio": 1.5,
	"threatinc_stanceWeakOdds": 0.5,
	"threatinc_stanceConsolidateShare": 0.5,
	# ...and at least stanceConsolidateMinPressed of them, or every one (0 =
	# the share alone): one besieged system of two is not half the hive.
	"threatinc_stanceConsolidateMinPressed": 2,
	"threatinc_stanceDwellDays": 30,
	"threatinc_stanceSecondaryShare": 0.5,
	# Consolidating (2026-10-04, it stopped both): the share of its appetite
	# the hive still spends on new claims (was 0), and whether it strikes any
	# world by its weakness rather than spoiling blows alone.
	"threatinc_stanceConsolidateSpreadShare": 1,
	"threatinc_stanceConsolidateStrikes": true,
	# A garrison slot is a promise of a certain weight of defense. A swarm shot
	# below this fraction of the fleet points it was fabricated with, or one of a
	# lower tier than the slot wants (a small colony's swarm sent to a big one),
	# is a WEAK HOLDER: it keeps fighting but no longer blocks the nexus, which
	# grows a proper replacement once the colony's fleet bank can pay for it and
	# recycles the weak one, its hulls back into the bank.
	"threatinc_garrisonUnderStrengthFraction": 0.5,
	"threatinc_economyGatesGrowth": true,
	# The first hive system carries Domain-era items the way a swarm out of the
	# Abyss would: a Pristine Nanoforge on its largest forge, and a Mantle Bore,
	# Plasma Dynamo, Catalytic Core or Synchrotron wherever its own deposits
	# leave a link short. Vanilla's chain only balances at size 8 with these;
	# every later colony draws on the home hive, and the items are the loot for
	# taking it. Every other forge in the hive has the chance below of carrying
	# a Corrupted Nanoforge - a fixed roll per world.
	"threatinc_homeRelics": true,
	"threatinc_forgeNanoforgeChance": 0.2,
	# The hive is a closed economy that never trades with the Core worlds, so
	# vanilla's distance-from-Core accessibility penalty models a supply line it
	# doesn't have. This cancels that penalty for hive colonies (1 = fully, 0 =
	# leave it). Distance from the rest of the hive does not move accessibility
	# either way: vanilla's same-faction proximity term is only ever a bonus.
	"threatinc_coreDistanceOffset": 1.0,
	# A disrupted port is a skeleton port. Vanilla keeps a disrupted Spaceport
	# counted as present, so it only loses the port's bonus and, since
	# same-faction shipping is 5+ units down to 0% accessibility, a disrupted
	# hive port changed nothing. While a hive world's port is disrupted its
	# shipping (imports and exports alike) is capped at this many units: a
	# size-8 forge gets 3 of the 8 metals it wants, growth stalls, its output
	# reaches the hive only as a trickle. Not zero on purpose - with the Core
	# also down a colony's machinery is imported, and zero shipping made a port
	# cut deadlier than a Core cut. 0 = nothing docks, -1 = vanilla behaviour.
	"threatinc_disruptedPortShipping": 3,
	"threatinc_convertDecivWorlds": true,
	# Defense-board contracts are ordinary missions: offered through the comm
	# network, accepted or ignored like a survey posting. Offers stand for
	# missionPostingDays and may be withdrawn until accepted; accepting one
	# starts a missionDurationDays completion clock, and failing or abandoning
	# it costs reputation with the sponsoring faction. Several offers stand at
	# once, split across two boards - a strategic tier naming the decisive
	# target and an immediate tier naming the low-hanging fruit, always at
	# least one of each - and the weakest offer on a board is withdrawn when a
	# better target of that same tier comes online. Accepted contracts are
	# never withdrawn and do not count against the offer cap.
	# Contracts are posted in a mobilised faction's name only (the nearest one
	# at war with the swarm); while no faction is mobilised the boards are silent.
	"threatinc_missionsEnabled": true,
	"threatinc_missionBaseReward": 150000,
	"threatinc_missionPostingDays": 90,
	"threatinc_missionDurationDays": 120,
	"threatinc_maxPostedMissions": 3,
	"threatinc_missionSupersedeMargin": 1.35,
	"threatinc_missionMinStandDays": 60,
	"threatinc_missionProximityBonus": 0.35,
	"threatinc_missionStrategicRewardMult": 1.5,

	# Phases are capability, not calendar: 2 = some colony can stage a strike,
	# 3 = some colony can field a full-budget armada (size 6+, nominal hulls)
	"threatinc_phase3Enabled": true,

	# Strikes: launched from colonies of at least strikeMinSize; strength is
	# size squared times the multiplier, degraded by hull shortages
	"threatinc_strikeLYPerFuel": 4.0,
	# Reach = strikeLYPerFuel x min(fuel available, fuel the fleets can carry).
	# The fleets carry this many units at a fleet-size figure of 100 percent.
	# Faction and player worlds use vanilla's own figure untouched (colony
	# size, doctrine, hull shortage, stability, alpha core, skills - the
	# Fleets percentage on the colony screen); hive worlds use vitality x
	# size / 4 (a healthy size-4 hive lifts a full load, size 8 twice that, a
	# size-2 foothold half, a besieged world less as its vitality falls).
	"threatinc_reachFuelCarry": 4,
	"threatinc_strikeMinSize": 4,
	"threatinc_strikeStrengthMult": 1.0,

	# Threat fleets built as archetypes (data/config/threatinc_fleets.json);
	# false = vanilla's mix
	"threatinc_fleetArchetypes": true,

	"threatinc_playerGraceDays": 120,
	# breaking the staging colony's forge (raid/bombardment/destruction) while
	# an expedition is still PREPARING there makes it stillborn; departed
	# expeditions are autonomous
	"threatinc_strikeRecallEnabled": true,
	# if false, strikes never target story-critical worlds (the engine refuses
	# to destroy them); if true, the swarm may erase them - can break unfinished
	# vanilla storylines
	"threatinc_destroyStoryCritical": true,

	# THREAT STRIKE DOCTRINE (docs/ground-war.md "Threat ground assaults"): the
	# swarm mirrors the siege it is subjected to. A strike softens a world's
	# tactical-bombardment structures, then LANDS a Threat-owned ground front
	# that pushes the colony's strata; only a ground victory destroys the
	# colony. Saturation bombardment is off by default - turn it back on to
	# restore the old "one pass wounds or erases a world" behaviour.
	"threatinc_strikeSaturationEnabled": false,
	"threatinc_strikeGroundFrontsEnabled": true,
	# the troop pool: strikeTroopsPerPoint per difficulty point of the swarms
	# mustered (3-9 each), fixed at launch, discounted by losses on the way,
	# split evenly across the worlds in the sweep, shown on the strike's intel
	# - a strike lands what it brought and nothing more
	"threatinc_strikeTroopsPerPoint": 20,
	# a world's share is never below this; a small strike lands fewer worlds
	# rather than token forces
	"threatinc_strikeFrontMinTroops": 300,
	# days of armaments a Threat landing carries; it is never resupplied except
	# by a follow-up pass of the same expedition
	"threatinc_strikeFrontSupplyDays": 90,
	# banked reserve marines that defend the ground when a colony is invaded
	"threatinc_reserveDefenseMult": 1.0,
	# counter-attack cadence bonus for a colony with a military industry
	"threatinc_colonyCounterAttackMilitaryMult": 1.5,

	# Sieges from orbit (docs/ground-war.md "Sieges from orbit", 2026-09-06),
	# the same duel over a hive and over a human colony. Defenders = garrison
	# x fortification. The garrison (a colony's base-by-size figure times
	# stability plus reserve marines; a hive's size-anchored strata) orbit
	# cannot touch. The fortification is each defence structure's multiplier
	# scaled by its condition - 1 intact, 0 once its disruption clock carries
	# the theatre's wear days (fortificationDisruptDays on a colony,
	# defenseWearDays on a hive) - instead of vanilla's on/off. On a colony
	# the rule applies to worlds besieged (or landed on), not to every raid.
	"threatinc_fortificationDisruptDays": 180,
	# A starved defence structure (its inputs short: a hive's machinery and
	# metals, a colony's supplies, marines and arms) loses this share of its
	# bonus at a full deficit, a partial deficit its share of it. Vanilla takes
	# all of it (1), which let any siege that outweighed a hive's orbit
	# switch its guns off by blockade before a shot (2026-10-12). 0 = inputs
	# never matter to the guns.
	"threatinc_defenseDeficitWeight": 0.5,
	# raiding a hive's Fabrication Core (the one raid on a war structure left,
	# 2026-09-28): marines lost grow by (tokens ^ depthLoss - 1) x the
	# defence's share of the fight x the Core's weight (Ground Defenses = 1)
	"threatinc_coreRaidDepthLoss": 1.5,
	"threatinc_coreRaidDepthWeight": 1.0,
	# Bombardment (docs/suppression-balance.md, v2 2026-09-28). A bombardment
	# is a day of sorties, once a day: every besieger - a Threat strike, a
	# faction's or the player's siege expedition, a Support or Defend sortie,
	# the player's own tactical bombardment - adds suppressDaysPerDay x fleet /
	# (fleet + defence) x condition disruption days per day to each
	# fortification (fleet points x siegeFPWeight against the ground-defence
	# figure). The x condition is what still stands: each pass finds fewer
	# targets, so orbit softens and boots finish. A hovering fleet makes up
	# the clock's own run-down (a day per day). A hive's figure is anchored to
	# its size and runs several times a colony's, so its rate is higher.
	"threatinc_siegeSuppressDaysPerDay": 12,
	"threatinc_hiveSiegeSuppressDaysPerDay": 30,
	"threatinc_siegeFPWeight": 1.0,
	# the player's bombardments share one lock: another within this many days
	"threatinc_bombardCooldownDays": 1,
	# fuel is ordnance: a tactical bombardment day burns this per fleet point
