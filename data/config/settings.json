	"threatinc_bombardFPWorth": 30,
	# the two above on the HIVE theatre (2026-10-13, the user, from the return-fire
	# tables in docs/suppression-balance.md): a fortified hive is a fleet-killer to
	# linger under - three times a colony's constant - and the worth is lowered so
	# the same commanders bombard a big hive as before (6,000 FP and up at a
	# size-8 Heavy Batteries hive; 3,000 and under land at full defence)
	"threatinc_hiveBombardReturnFirePerGunDefence": 0.0024,
	"threatinc_hiveBombardFPWorth": 10,
	# THE DROP UNDER THE GUNS (2026-10-18, the user: "marines lost to heavy batteries like FP
	# is lost to bombardment"): a landing loses this x the defence the batteries still add
